# Copy this file to .env and fill in your own values. Never commit .env.

# --- Alpaca (paper by default) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Paper: https://paper-api.alpaca.markets  Live: https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# --- Live trading safety gate ---
# Must be exactly YES, AND the bot will still prompt for a typed confirmation
# at startup, for live orders to be allowed. Leave unset/blank for paper mode.
LIVE_TRADING_CONFIRM=

# --- Config override (optional) ---
FLUX_CONFIG_PATH=config.yaml
